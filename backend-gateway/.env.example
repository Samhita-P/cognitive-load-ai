DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

ML_SERVICE_URL=http://127.0.0.1:8001/api/infer
# Production Database (Neon PostgreSQL)
# Example: postgres://[user]:[password]@[ep-name].region.aws.neon.tech/[dbname]?sslmode=require
# Note: In production, Neon's pooled endpoint is recommended to prevent connection starvation.
# DATABASE_URL=postgres://...

# Local dev fallback (SQLite) - used if DATABASE_URL is not set or empty.
REDIS_URL=redis://127.0.0.1:6379/0

# Dev-only (requires DJANGO_DEBUG=1). Never enable in production.
ALLOW_DEV_INSECURE_TELEMETRY=0

# ML Service Concurrency Tuning
MAX_CONCURRENT_INFERENCE=50
MAX_THREADPOOL_WORKERS=100
INFERENCE_TIMEOUT_MS=400

# WebSocket Security Hardening
WS_MAX_MESSAGES_PER_MIN=30
WS_MAX_PAYLOAD_BYTES=51200
