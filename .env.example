# ==============================================================================
# Cognitive Load AI - Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` and fill in the actual values.

# ------------------------------------------------------------------------------
# Backend Gateway (Django)
# ------------------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=your_super_secret_key_here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend-gateway

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://cognitive:cognitive_password@db:5432/cognitive_db

# Redis URL (used for Django Channels / websockets)
REDIS_URL=redis://redis:6379/0

# ML Service URL (internal Docker network)
ML_SERVICE_URL=http://ml-service:8001/api/infer

# JWT Authentication
JWT_SECRET_KEY=another_super_secret_key_here

# ------------------------------------------------------------------------------
# ML Service (FastAPI)
# ------------------------------------------------------------------------------
PORT=8001
ENV=production
# URL for the ML service to connect back to the gateway for mock/demo purposes
GATEWAY_WS_URL=ws://backend-gateway:8000/ws/telemetry/
# Provide a valid JWT token here if the demo generator needs to bypass auth
DEMO_GATEWAY_JWT=

# Inference Configuration
INFERENCE_TIMEOUT_MS=400

# ------------------------------------------------------------------------------
# Frontend (React + Vite)
# ------------------------------------------------------------------------------
# These are baked in at build time. Use localhost for local dev outside Docker.
VITE_API_BASE_URL=http://localhost:8000
VITE_GATEWAY_WS_URL=ws://localhost:8000/ws/telemetry/
VITE_ML_BASE_URL=http://localhost:8001
