# Copy to ".env" and adjust. Used by docker compose variable substitution where noted.

# --- Django gateway (docker-compose: backend-gateway) ---
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend-gateway
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:80
# ML_SERVICE_URL=http://ml-service:8001/api/infer
# DATABASE_URL=postgres://cognitive:cognitive_password@db:5432/cognitive_db
# REDIS_URL=redis://redis:6379/0

# Dev-only: allow WebSocket /ws/telemetry/ without ?token= (uses user "telemetry_dev").
# Requires DJANGO_DEBUG=1. Never enable in production.
# ALLOW_DEV_INSECURE_TELEMETRY=0

# --- ML service demo subprocess (docker-compose: ml-service) ---
# JWT access string for mock_generator when gateway requires auth.
# DEMO_GATEWAY_JWT=

# --- Frontend Docker build (docker-compose: frontend build args) ---
# Browser-reachable URLs from the user's machine (not Docker service names).
# VITE_API_BASE_URL=http://localhost:8000
# VITE_GATEWAY_WS_URL=ws://localhost:8000/ws/telemetry/
# VITE_ML_BASE_URL=http://localhost:8001

# --- Phase B: training pipeline (see README) ---
# python manage.py export_feedback_dataset > feedback.jsonl
# python ml-service/scripts/train_rf.py feedback.jsonl
